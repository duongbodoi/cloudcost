{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "PublishAlertToTopic",
      "Effect": "Allow",
      "Action": "sns:Publish",
      "Resource": "arn:aws:sns:us-east-1:<ACCOUNT_ID>:Cost-Guardian"
    },
    {
      "Sid": "WriteOwnLogs",
      "Effect": "Allow",
      "Action": ["logs:CreateLogGroup", "logs:CreateLogStream", "logs:PutLogEvents"],
      "Resource": [
        "arn:aws:logs:us-east-1:<ACCOUNT_ID>:log-group:/aws/lambda/cg-chargeable-event",
        "arn:aws:logs:us-east-1:<ACCOUNT_ID>:log-group:/aws/lambda/cg-chargeable-event:*"
      ]
    },
    {
      "Sid": "TagEc2OwnerCreatedByOnly",
      "Effect": "Allow",
      "Action": "ec2:CreateTags",
      "Resource": [
        "arn:aws:ec2:*:<ACCOUNT_ID>:instance/*",
        "arn:aws:ec2:*:<ACCOUNT_ID>:natgateway/*",
        "arn:aws:ec2:*:<ACCOUNT_ID>:elastic-ip/*"
      ],
      "Condition": {
        "ForAllValues:StringEquals": { "aws:TagKeys": ["Owner", "CreatedBy"] },
        "Null": { "aws:TagKeys": "false" }
      }
    },
    {
      "Sid": "TagRdsOwnerCreatedByOnly",
      "Effect": "Allow",
      "Action": "rds:AddTagsToResource",
      "Resource": "arn:aws:rds:*:<ACCOUNT_ID>:db:*",
      "Condition": {
        "ForAllValues:StringEquals": { "aws:TagKeys": ["Owner", "CreatedBy"] },
        "Null": { "aws:TagKeys": "false" }
      }
    },
    {
      "Sid": "TagLoadBalancerOwnerCreatedByOnly",
      "Effect": "Allow",
      "Action": "elasticloadbalancing:AddTags",
      "Resource": "arn:aws:elasticloadbalancing:*:<ACCOUNT_ID>:loadbalancer/*",
      "Condition": {
        "ForAllValues:StringEquals": { "aws:TagKeys": ["Owner", "CreatedBy"] },
        "Null": { "aws:TagKeys": "false" }
      }
    },
    {
      "Sid": "TagEksOwnerCreatedByOnly",
      "Effect": "Allow",
      "Action": "eks:TagResource",
      "Resource": [
        "arn:aws:eks:*:<ACCOUNT_ID>:cluster/*",
        "arn:aws:eks:*:<ACCOUNT_ID>:nodegroup/*"
      ],
      "Condition": {
        "ForAllValues:StringEquals": { "aws:TagKeys": ["Owner", "CreatedBy"] },
        "Null": { "aws:TagKeys": "false" }
      }
    },
    {
      "Sid": "TagElastiCacheOwnerCreatedByOnly",
      "Effect": "Allow",
      "Action": "elasticache:AddTagsToResource",
      "Resource": [
        "arn:aws:elasticache:*:<ACCOUNT_ID>:cluster:*",
        "arn:aws:elasticache:*:<ACCOUNT_ID>:replicationgroup:*",
        "arn:aws:elasticache:*:<ACCOUNT_ID>:serverlesscache:*"
      ],
      "Condition": {
        "ForAllValues:StringEquals": { "aws:TagKeys": ["Owner", "CreatedBy"] },
        "Null": { "aws:TagKeys": "false" }
      }
    },
    {
      "Sid": "LookupPrice",
      "Effect": "Allow",
      "Action": "pricing:GetProducts",
      "Resource": "*"
    },
    {
      "Sid": "ReadTypeForRestartEvents",
      "Effect": "Allow",
      "Action": ["ec2:DescribeInstances", "rds:DescribeDBInstances"],
      "Resource": "*"
    }
  ]
}
